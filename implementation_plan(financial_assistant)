## Database Schema

```sql
-- Users
users (id, telegram_id, username, full_name, role, onboarding_complete, briefing_time, timezone, created_at)

-- User Preferences
user_preferences (id, user_id, sectors[], risk_tolerance, investment_style, created_at, updated_at)

-- Conversation History (short-term)
conversations (id, user_id, role, content, created_at)

-- Semantic Memory (long-term, embedded)
memories (id, user_id, content, embedding vector(768), memory_type, importance, created_at)

-- Watchlists
watchlists (id, user_id, ticker, company_name, added_at, notes)

-- Alerts
alerts (id, user_id, ticker, condition, threshold, triggered, last_checked, created_at)

-- Documents
documents (id, user_id, filename, file_type, status, created_at)

-- Document Chunks (for RAG)
document_chunks (id, document_id, content, embedding vector(768), chunk_index)

-- Research History
research_history (id, user_id, query, result_summary, tickers[], created_at)

-- Scheduled Tasks
scheduled_tasks (id, user_id, task_type, cron_expr, last_run, is_active)
```

